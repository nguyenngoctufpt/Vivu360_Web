<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập — Admin Vivu360</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
</head>
<body>
<div class="login-page">
  <div style="position:relative;z-index:1;width:100%;max-width:920px;padding:24px;display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center;">

    <!-- LEFT: Login card -->
    <div class="login-card">
      <div class="login-logo">
        <div class="login-logo-icon">
          <i data-lucide="globe" style="color:white;width:28px;height:28px;"></i>
        </div>
        <h1>Vivu360</h1>
        <p>Admin Control Panel</p>
      </div>

      <% if (error) { %>
        <div class="login-error">
          <i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i>
          <%= error %>
        </div>
      <% } %>

      <form class="login-form" method="POST" action="/login" id="loginForm">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="admin@vivu360.vn" required autofocus>
        </div>
        <div class="form-group">
          <label for="password">Mật khẩu</label>
          <div style="position:relative;">
            <input type="password" id="password" name="password" placeholder="••••••••" required>
            <button type="button" id="togglePwd" style="position:absolute;right:11px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-dim);cursor:pointer;padding:4px;display:flex;align-items:center;">
              <i data-lucide="eye" id="eyeIcon" style="width:15px;height:15px;"></i>
            </button>
          </div>
        </div>
        <button type="submit" class="login-btn">
          <i data-lucide="log-in" style="width:15px;height:15px;display:inline-block;vertical-align:middle;margin-right:6px;"></i>
          Đăng nhập
        </button>
      </form>

      <div style="margin-top:20px;text-align:center;font-size:11px;color:var(--text-dim);">
        Vivu360 Admin v2.0 &nbsp;·&nbsp; Bảo mật SSL &nbsp;·&nbsp; RBAC
      </div>
    </div>

    <!-- RIGHT: Role selector -->
    <div style="display:flex;flex-direction:column;gap:14px;">
      <div style="text-align:center;margin-bottom:4px;">
        <div style="font-size:11px;font-weight:800;color:var(--text-dim);text-transform:uppercase;letter-spacing:2px;margin-bottom:4px;">Chọn nhanh tài khoản</div>
        <div style="font-size:12px;color:var(--text-muted)">Click để điền tự động</div>
      </div>

      <%
      const groups = {};
      accounts.forEach(acc => {
        const roleDef = ROLES[acc.role] || {};
        const group = roleDef.group || 'Other';
        if (!groups[group]) groups[group] = [];
        groups[group].push({ ...acc, roleDef });
      });
      const groupColors = {
        'System & Tech':        '#22d3ee',
        'Operations & Content': '#10b981',
        'User Support':         '#6366f1',
        'Marketing & Growth':   '#ec4899',
      };
      %>

      <% Object.entries(groups).forEach(([groupName, accs]) => { %>
      <div style="background:rgba(13,13,24,0.7);border:1px solid var(--border);border-radius:14px;overflow:hidden;backdrop-filter:blur(16px);">
        <div style="padding:10px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:7px;">
          <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:<%= groupColors[groupName]||'#64748b' %>;"></span>
          <span style="font-size:9.5px;font-weight:900;color:<%= groupColors[groupName]||'#64748b' %>;text-transform:uppercase;letter-spacing:1.5px;"><%= groupName %></span>
        </div>
        <% accs.forEach(acc => { %>
        <div class="role-row" data-email="<%= acc.email %>" data-pwd="<%= acc.password %>"
          style="display:flex;align-items:center;gap:10px;padding:10px 14px;cursor:pointer;transition:background .18s;border-bottom:1px solid rgba(255,255,255,0.03);">
          <div style="width:30px;height:30px;border-radius:8px;background:<%= acc.roleDef.bgColor||'rgba(100,116,139,0.1)' %>;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i data-lucide="<%= acc.roleDef.icon||'user' %>" style="width:13px;height:13px;color:<%= acc.roleDef.color||'#64748b' %>"></i>
          </div>
          <div style="flex:1;min-width:0;">
            <div style="font-size:12px;font-weight:700;color:var(--text-primary)"><%= acc.roleDef.label||acc.role %></div>
            <div style="font-size:10px;color:var(--text-muted);font-family:'JetBrains Mono',monospace"><%= acc.email %></div>
          </div>
          <div style="font-size:9px;font-weight:700;padding:2px 7px;border-radius:6px;background:rgba(255,255,255,0.04);color:var(--text-dim);border:1px solid var(--border);">
            Lv.<%= acc.roleDef.level||0 %>
          </div>
        </div>
        <% }) %>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<script>
  if (typeof lucide !== 'undefined') lucide.createIcons();

  // Toggle password visibility
  const toggleBtn = document.getElementById('togglePwd');
  const pwdInput  = document.getElementById('password');
  let visible = false;
  toggleBtn.addEventListener('click', () => {
    visible = !visible;
    pwdInput.type = visible ? 'text' : 'password';
    document.getElementById('eyeIcon').setAttribute('data-lucide', visible ? 'eye-off' : 'eye');
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });

  // Click role row to autofill
  document.querySelectorAll('.role-row').forEach(row => {
    row.addEventListener('mouseenter', () => row.style.background='rgba(255,255,255,0.04)');
    row.addEventListener('mouseleave', () => row.style.background='');
    row.addEventListener('click', () => {
      document.getElementById('email').value    = row.dataset.email;
      document.getElementById('password').value = row.dataset.pwd;
      document.querySelectorAll('.role-row').forEach(r => r.style.background='');
      row.style.background='rgba(99,102,241,0.08)';
    });
  });

  // Responsive: stack vertically on small screens
  if (window.innerWidth < 768) {
    document.querySelector('[style*="grid-template-columns"]').style.gridTemplateColumns='1fr';
    document.querySelector('[style*="grid-template-columns"]').style.maxWidth='480px';
  }
</script>
</body>
</html>
