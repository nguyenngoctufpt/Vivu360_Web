<header class="top-header">
  <div class="header-left">
    <button class="sidebar-toggle" id="sidebarToggleBtn">
      <i data-lucide="menu" style="width:17px;height:17px;"></i>
    </button>
    <div class="header-breadcrumb">
      <span class="crumb">Vivu360</span>
      <span class="separator">›</span>
      <span class="crumb-active"><%= title %></span>
    </div>
  </div>

  <div class="header-right">
    <!-- Global Quick Search -->
    <div class="header-search">
      <i data-lucide="search" style="width:13px;height:13px;"></i>
      <input type="text" placeholder="Tìm kiếm nhanh..." id="tableSearch" autocomplete="off">
    </div>

    <!-- Refresh button -->
    <button class="header-btn" id="refreshPageBtn" data-tooltip="Làm mới">
      <i data-lucide="refresh-cw" style="width:15px;height:15px;"></i>
    </button>

    <!-- Notification Bell -->
    <div style="position:relative;display:inline-block;">
      <button class="header-btn" id="notifBellBtn" data-tooltip="Thông báo">
        <i data-lucide="bell" style="width:15px;height:15px;"></i>
        <span class="notif-dot" id="notifDot"></span>
      </button>

      <!-- Dropdown -->
      <div id="notifDropdown" style="
        display:none; position:absolute; right:0; top:calc(100% + 10px);
        width:330px; background:var(--bg-card); border:1px solid var(--border-hover);
        border-radius:var(--radius); box-shadow:var(--shadow-lg); z-index:1000; overflow:hidden;
      ">
        <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
          <span style="font-size:13px;font-weight:700;color:var(--text-primary);">Thông báo</span>
          <span style="font-size:10px;font-weight:700;padding:2px 8px;background:var(--accent-glow);color:var(--accent-light);border-radius:100px;border:1px solid rgba(99,102,241,0.2);">Mới nhất</span>
        </div>
        <div style="max-height:300px;overflow-y:auto;">
          <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;gap:10px;align-items:flex-start;cursor:pointer;transition:var(--transition);" class="notif-item-row">
            <div style="width:32px;height:32px;border-radius:50%;background:var(--green-bg);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--green);">
              <i data-lucide="database" style="width:13px;height:13px;"></i>
            </div>
            <div style="flex:1;font-size:12px;">
              <div style="color:var(--text-primary);font-weight:600;">Firebase đã kết nối thành công</div>
              <div style="color:var(--text-muted);font-size:11px;margin-top:2px;">Dữ liệu người dùng đang đồng bộ realtime</div>
              <div style="color:var(--text-dim);font-size:10px;margin-top:4px;">Vừa xong</div>
            </div>
          </div>
          <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;gap:10px;align-items:flex-start;cursor:pointer;transition:var(--transition);" class="notif-item-row">
            <div style="width:32px;height:32px;border-radius:50%;background:var(--accent-glow);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--accent-light);">
              <i data-lucide="users" style="width:13px;height:13px;"></i>
            </div>
            <div style="flex:1;font-size:12px;">
              <div style="color:var(--text-primary);font-weight:600;">Người dùng mới đăng ký</div>
              <div style="color:var(--text-muted);font-size:11px;margin-top:2px;">Kiểm tra danh sách người dùng</div>
              <div style="color:var(--text-dim);font-size:10px;margin-top:4px;">Hôm nay</div>
            </div>
          </div>
          <div style="padding:12px 16px;display:flex;gap:10px;align-items:flex-start;cursor:pointer;transition:var(--transition);" class="notif-item-row">
            <div style="width:32px;height:32px;border-radius:50%;background:var(--purple-bg);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--purple);">
              <i data-lucide="file-text" style="width:13px;height:13px;"></i>
            </div>
            <div style="flex:1;font-size:12px;">
              <div style="color:var(--text-primary);font-weight:600;">Bài viết mới cần duyệt</div>
              <div style="color:var(--text-muted);font-size:11px;margin-top:2px;">Có bài viết mới từ cộng đồng</div>
              <div style="color:var(--text-dim);font-size:10px;margin-top:4px;">1 giờ trước</div>
            </div>
          </div>
        </div>
        <a href="/notifications" style="display:block;padding:10px;text-align:center;font-size:11px;font-weight:700;color:var(--accent-light);border-top:1px solid var(--border);transition:var(--transition);"
           onmouseover="this.style.background='rgba(99,102,241,0.06)'" onmouseout="this.style.background='transparent'">
          Xem tất cả thông báo →
        </a>
      </div>
    </div>

    <!-- Settings shortcut -->
    <a href="/config" class="header-btn" data-tooltip="Cài đặt hệ thống" style="text-decoration:none;">
      <i data-lucide="settings" style="width:15px;height:15px;"></i>
    </a>

    <!-- Admin avatar / profile -->
    <div style="width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,var(--accent),var(--purple));
      display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;color:white;cursor:pointer;
      box-shadow:0 2px 10px rgba(99,102,241,0.35);flex-shrink:0;" data-tooltip="Tài khoản của bạn">
      <%= typeof currentUser !== 'undefined' && currentUser ? currentUser.name.charAt(0).toUpperCase() : 'A' %>
    </div>
  </div>
</header>
